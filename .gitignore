# Byte-compiled / cache
__pycache__/
*.py[cod]
*.egg-info/

# Virtual environments (per device)
.venv/
venv/

# Local machine config (keep example committed)
devices/*/config.json
.env

# Choreography runtime signals
devices/*/signals/*
!devices/*/signals/.gitkeep

# Instrument read results (machine-specific output)
devices/*/results/*
!devices/*/results/.gitkeep

# OS / editor
.DS_Store
*.log

# Do not ship built zips inside the working tree by default
dist/*.zip

# Per-computer operator / git / path facts (keep example only)
machines/*_HANDOFF.md
!machines/MACHINE_HANDOFF.example.md

# Local tooling (gh CLI binary)
.tools/
