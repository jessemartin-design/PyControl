# Copy to .env and fill in. Never commit .env.
# Same username/password as the MiR web UI.
# Note: the API hashes the password (SHA-256) and that hash is case-sensitive.
# If the UI accepts your password but the script fails, try the password in
# the exact case originally set on the robot (often all lowercase).

MIR_HOST=10.14.19.160
MIR_USERNAME=
MIR_PASSWORD=

# Optional. Leave blank to auto-detect. Confirmed working path:
# MIR_API_BASE=http://10.14.19.160/api/v2.0.0

# Set true only if you switch to HTTPS with a trusted cert.
MIR_VERIFY_TLS=false

# Optional HTTP timeouts (seconds). Defaults: connect 15, read 60.
# Raise MIR_READ_TIMEOUT if the GUI times out between draft steps while the robot is busy.
# MIR_HTTP_TIMEOUT=30
# MIR_CONNECT_TIMEOUT=15
# MIR_READ_TIMEOUT=90

# Optional transient WiFi blip retries (shared by CLI + GUI). Defaults: 3 retries, 1s backoff.
# Set MIR_HTTP_RETRIES=0 to disable (revert to single-attempt behavior).
# MIR_HTTP_RETRIES=3
# MIR_HTTP_RETRY_BACKOFF=1.0
